APP_NAME="LMS Kesetaraan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Taipei

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms_kesetaraan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
# sync = job (spt kirim email kredensial) langsung jalan saat request, tidak perlu queue worker terpisah.
# Untuk production sebaiknya pakai queue asli (redis/database) + `php artisan queue:work`.
QUEUE_CONNECTION=sync
CACHE_STORE=file
BROADCAST_CONNECTION=log

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum — origin web & mobile yang diizinkan pakai cookie/token auth
SANCTUM_STATEFUL_DOMAINS=localhost:3000,app.lms-kesetaraan.sch.id
SESSION_DOMAIN=localhost

# URL frontend Next.js — dipakai untuk redirect setelah login Google & link di email.
FRONTEND_URL=http://localhost:3000

# Google OAuth — tombol "Login dengan Google" (murid/guru/admin yang akunnya sudah ada).
# Cara membuatnya: buka Google Cloud Console -> buat/pilih project -> APIs & Services
# -> Credentials -> Create Credentials -> OAuth client ID -> Web application.
# Authorized redirect URI diisi PERSIS sama dengan GOOGLE_REDIRECT_URI di bawah ini.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Filesystem: local | s3 | cloudinary
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=lms-kesetaraan-files
AWS_USE_PATH_STYLE_ENDPOINT=false

# Untuk kirim OTP lupa password ke email asli, contoh pakai Gmail:
# 1. Aktifkan verifikasi 2 langkah di akun Gmail yang dipakai.
# 2. Buat "App Password" di myaccount.google.com/apppasswords (pilih app "Mail").
# 3. Isi MAIL_USERNAME dengan email Gmail itu, MAIL_PASSWORD dengan App Password (16 karakter, tanpa spasi).
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@pkbmppitaiwan.sch.id"
MAIL_FROM_NAME="PKBM PPI Taiwan"

# Firebase Cloud Messaging (push notification)
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Bisnis: bobot & passing grade default (override via tabel bobot_nilai_config)
NILAI_BOBOT_TUGAS=30
NILAI_BOBOT_KUIS=30
NILAI_BOBOT_ABSENSI=10
NILAI_BOBOT_UJIAN=30
NILAI_PASSING_GRADE=75

# Reminder pertemuan online (menit sebelum jadwal)
REMINDER_MENIT_SEBELUM=15
